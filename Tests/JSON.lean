import Challenge.Specs.JSON

/-!
# JSON parser tests

These tests are derived from the standard
[JSONTestSuite](https://github.com/nst/JSONTestSuite) `test_parsing` vectors,
plus a handful of hand-written cases pinning exact structured values.

* `y_*` vectors MUST be accepted — asserted as `(parse ...).isSome = true`.
* `n_*` vectors MUST be rejected — asserted as `(parse ...).isNone = true`.
* `i_*` vectors are implementation-defined and are intentionally **not**
  asserted (lone/invalid surrogates, non-UTF-8 encodings, huge exponents,
  BOMs — our parser makes a reasonable but unspecified choice on these).

Two pathological `n_structure_*` vectors are **skipped**:
`n_structure_100000_opening_arrays` and `n_structure_open_array_object`
(100 000-deep / 250 kB inputs) would blow the native compiler stack during
`native_decide` and do not add spec coverage beyond the moderate-depth cases.
All committed tests pass.
-/

namespace Specs.JSON.Tests

open Specs.JSON

/-! ## Hand-written exact-value tests

    These pin the exact structured `JSON` output, verifying the record shape and
    not merely that parsing succeeds. -/

/-- `42` -/
example : parse (#v[0x34, 0x32] : Vector ℕ 2)
    = some (JSON.num ⟨false, [4, 2], [], false, []⟩) := by native_decide

/-- `-0` -/
example : parse (#v[0x2d, 0x30] : Vector ℕ 2)
    = some (JSON.num ⟨true, [0], [], false, []⟩) := by native_decide

/-- `3.14` -/
example : parse (#v[0x33, 0x2e, 0x31, 0x34] : Vector ℕ 4)
    = some (JSON.num ⟨false, [3], [1, 4], false, []⟩) := by native_decide

/-- `1e10` -/
example : parse (#v[0x31, 0x65, 0x31, 0x30] : Vector ℕ 4)
    = some (JSON.num ⟨false, [1], [], false, [1, 0]⟩) := by native_decide

/-- `-2.5E-3` : sign, fraction and negative exponent all recorded. -/
example : parse (#v[0x2d, 0x32, 0x2e, 0x35, 0x45, 0x2d, 0x33] : Vector ℕ 7)
    = some (JSON.num ⟨true, [2], [5], true, [3]⟩) := by native_decide

/-- `true` / `false` / `null` -/
example : parse (#v[0x74, 0x72, 0x75, 0x65] : Vector ℕ 4) = some (JSON.bool true) := by native_decide
example : parse (#v[0x66, 0x61, 0x6c, 0x73, 0x65] : Vector ℕ 5) = some (JSON.bool false) := by native_decide
example : parse (#v[0x6e, 0x75, 0x6c, 0x6c] : Vector ℕ 4) = some JSON.null := by native_decide

/-- `""` (empty string) and `"hi"` -/
example : parse (#v[0x22, 0x22] : Vector ℕ 2) = some (JSON.str []) := by native_decide
example : parse (#v[0x22, 0x68, 0x69, 0x22] : Vector ℕ 4)
    = some (JSON.str [0x68, 0x69]) := by native_decide

/-- `"\n\t"` : escape decoding. -/
example : parse (#v[0x22, 0x5c, 0x6e, 0x5c, 0x74, 0x22] : Vector ℕ 6)
    = some (JSON.str [0x0a, 0x09]) := by native_decide

/-- `"A"` decodes to code point `A` (0x41). -/
example : parse (#v[0x22, 0x5c, 0x75, 0x30, 0x30, 0x34, 0x31, 0x22] : Vector ℕ 8)
    = some (JSON.str [0x41]) := by native_decide

/-- `"𝄞"` (a surrogate pair) combines to U+1D11E. -/
example : parse (#v[0x22, 0x5c, 0x75, 0x44, 0x38, 0x33, 0x34,
                    0x5c, 0x75, 0x44, 0x44, 0x31, 0x45, 0x22] : Vector ℕ 14)
    = some (JSON.str [0x1D11E]) := by native_decide

/-- A 3-byte UTF-8 character (U+20AC, the euro sign) decodes to one code point. -/
example : parse (#v[0x22, 0xe2, 0x82, 0xac, 0x22] : Vector ℕ 5)
    = some (JSON.str [0x20AC]) := by native_decide

/-- `[]` and `{}` -/
example : parse (#v[0x5b, 0x5d] : Vector ℕ 2) = some (JSON.arr []) := by native_decide
example : parse (#v[0x7b, 0x7d] : Vector ℕ 2) = some (JSON.obj []) := by native_decide

/-- `[1, 2, 3]` with interior whitespace. -/
example : parse (#v[0x5b, 0x31, 0x2c, 0x20, 0x32, 0x2c, 0x20, 0x33, 0x5d] : Vector ℕ 9)
    = some (JSON.arr [JSON.num ⟨false, [1], [], false, []⟩,
                      JSON.num ⟨false, [2], [], false, []⟩,
                      JSON.num ⟨false, [3], [], false, []⟩]) := by native_decide

/-- `{"asd":"sdf"}` -/
example : parse (#v[0x7b, 0x22, 0x61, 0x73, 0x64, 0x22, 0x3a,
                    0x22, 0x73, 0x64, 0x66, 0x22, 0x7d] : Vector ℕ 13)
    = some (JSON.obj [([0x61, 0x73, 0x64], JSON.str [0x73, 0x64, 0x66])]) := by native_decide

/-- `{"a":[1,true,null,"x"]}` : nested object/array/values, order preserved. -/
example : parse (#v[0x7b, 0x22, 0x61, 0x22, 0x3a, 0x5b, 0x31, 0x2c, 0x74, 0x72, 0x75, 0x65,
                    0x2c, 0x6e, 0x75, 0x6c, 0x6c, 0x2c, 0x22, 0x78, 0x22, 0x5d, 0x7d]
                   : Vector ℕ 23)
    = some (JSON.obj [([0x61], JSON.arr [
        JSON.num ⟨false, [1], [], false, []⟩, JSON.bool true, JSON.null,
        JSON.str [0x78]])]) := by native_decide

