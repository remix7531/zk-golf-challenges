    Operations.Requirements env ((main input).operations n) := by
  unfold main
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_witnessVector ..) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_witnessVector ..) fun _ _ => ?_
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_witnessIR ..) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_map fun _ _ => req_subA env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  refine req_bind env (req_assertion env _ rfl _ _) fun _ _ => ?_
  exact req_pure ..

set_option maxHeartbeats 2000000 in
set_option maxRecDepth 20000 in
theorem soundness : GeneralFormalCircuit.Soundness (F circomPrime) main Assumptions Spec := by
  intro i₀ env input_var input h_input h_assumptions h_holds
  refine ⟨?_, main_requirements env input_var i₀⟩
  obtain ⟨hbytes, hlen⟩ := h_assumptions
  unfold main at h_holds
  obtain ⟨m1, x1, hx1, ho1, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m2, x2, hx2, ho2, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m3, x3, hx3, ho3, hLen, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m4, x4, hx4, ho4, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m5, x5, hx5, ho5, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m6, x6, hx6, ho6, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m7, x7, hx7, ho7, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m8, x8, hx8, ho8, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m9, x9, hx9, ho9, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m10, x10, hx10, ho10, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m11, x11, hx11, ho11, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m12, x12, hx12, ho12, -, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m13, x13, hx13, ho13, hAnch, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m14, x14, hx14, ho14, hMap, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m15, x15, hx15, ho15, hAcc, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m16, x16, hx16, ho16, hP0, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m17, x17, hx17, ho17, hP1, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m18, x18, hx18, ho18, hP2, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m19, x19, hx19, ho19, hP3, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m20, x20, hx20, ho20, hP4, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m21, x21, hx21, ho21, hP5, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m22, x22, hx22, ho22, hP6, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m23, x23, hx23, ho23, hP7, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m24, x24, hx24, ho24, hP8, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m25, x25, hx25, ho25, hP9, h_holds⟩ := chs_bind env h_holds
  obtain ⟨m26, x26, hx26, ho26, hP10, h_holds⟩ := chs_bind env h_holds
  rw [chs_assertion] at hLen hAnch hAcc hP0 hP1 hP2 hP3 hP4 hP5 hP6 hP7 hP8 hP9 hP10
  have hMap' := chs_map_subA hMap
  simp only [Vector.getElem_finRange, ← hx14] at hMap' 
  have hout : (main input_var).output i₀ = x1 := by
    unfold main
    exact ho1.trans (ho2.trans (ho3.trans (ho4.trans (ho5.trans (ho6.trans (ho7.trans
      (ho8.trans (ho9.trans (ho10.trans (ho11.trans (ho12.trans (ho13.trans (ho14.trans
      (ho15.trans (ho16.trans (ho17.trans (ho18.trans (ho19.trans (ho20.trans (ho21.trans
      (ho22.trans (ho23.trans (ho24.trans (ho25.trans ho26))))))))))))))))))))))))
  -- the input, read as plain data
  have h_bufi : ∀ (i : ℕ) (hi : i < bufferLen),
      Expression.eval env (input_var.buffer[i]'hi) = input.buffer[i]'hi := by
    intro i hi
    rw [← h_input, eval_inputStruct]
    simp only [getElem_eval_vec]
  have h_len : Expression.eval env input_var.len = input.len := by
    rw [← h_input, eval_inputStruct]
  -- the gadget specifications, unfolded
  simp only [show LenFlags.circuit.Assumptions = LenFlags.Assumptions from rfl,
    show LenFlags.circuit.Spec = LenFlags.Spec from rfl, LenFlags.Assumptions, LenFlags.Spec,
    true_implies] at hLen
  rw [eval_lenFlagsIn] at hLen
  simp only [show Anchors.circuit.Assumptions = Anchors.Assumptions from rfl,
    show Anchors.circuit.Spec = Anchors.Spec from rfl, Anchors.Assumptions, Anchors.Spec,
    true_implies] at hAnch
  rw [eval_anchorsIn] at hAnch
  simp only [show Acceptance.circuit.Assumptions = Acceptance.Assumptions from rfl,
    show Acceptance.circuit.Spec = Acceptance.Spec from rfl, Acceptance.Assumptions,
    Acceptance.Spec, true_implies] at hAcc
  rw [eval_acceptanceIn] at hAcc
  simp only [show Step.circuit.Assumptions = Step.Assumptions from rfl,
    show Step.circuit.Spec = Step.Spec from rfl, Fin.eta] at hMap'
  set R := MainSound.ofVectors env input_var.buffer x2 x4 x7 x8 x11 x12 x5 x6 x9 x10 x14 x1
    with hRdef
  have hRows : MainSound.Rows R (MainSound.bufBytes input.buffer) input.len.val env.data := by
    refine ⟨?_, ?_, hlen, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro i hi
      show (Expression.eval env ((input_var.buffer[i]?).getD 0)).val = _
      rw [MainSound.gd _ _ hi, h_bufi i hi, MainSound.bufBytes_lt _ i hi]
    · intro i
      by_cases hi : i < bufferLen
      · rw [MainSound.bufBytes_lt _ i hi]
        have := hbytes ⟨i, hi⟩
        simpa [fieldElemsToNat] using this
      · rw [MainSound.bufBytes_ge _ i hi]; omega
    · intro i hi
      show Expression.eval env ((x2[i]?).getD 0) = _
      rw [MainSound.gd _ _ (Nat.lt_succ_of_lt hi)]
      have h := hLen.2 ⟨i, Nat.lt_succ_of_lt hi⟩
      simp only [Fin.getElem_fin, getElem_eval_vec] at h
      rw [h, h_len]
    · show Expression.eval env ((x4[0]?).getD 0) = 0
      rw [MainSound.gd _ _ (by simp [slots])]
      exact hAnch.1
    · show Expression.eval env ((x5[0 * nSt + St.PRE.val]?).getD 0) = 1
      have h := hAnch.2.1
      simp only [MainSound.eval_sliceAt, Fin.getElem_fin, Vector.getElem_ofFn] at h
      exact h
    · show Expression.eval env ((x6[0 * nSub + Sub.PLAIN.val]?).getD 0) = 1
      have h := hAnch.2.2.1
      simp only [MainSound.eval_sliceAt, Fin.getElem_fin, Vector.getElem_ofFn] at h
      exact h
    · show Expression.eval env ((x7[0]?).getD 0) = 0
      rw [MainSound.gd _ _ (by simp [slots])]
      exact hAnch.2.2.2.1
    · show Expression.eval env ((x8[0]?).getD 0) = 0
      rw [MainSound.gd _ _ (by simp [slots])]
      exact hAnch.2.2.2.2.1
    · show Expression.eval env ((x11[0]?).getD 0) = 0
      rw [MainSound.gd _ _ (by simp [slots])]
      exact hAnch.2.2.2.2.2.1
    · show Expression.eval env ((x12[0]?).getD 0) = 0
      rw [MainSound.gd _ _ (by simp [slots])]
      exact hAnch.2.2.2.2.2.2.1
    · intro k
      show Expression.eval env ((x9[0 * nClaims + k.val]?).getD 0) = 0
      have h := hAnch.2.2.2.2.2.2.2.1 k
      simp only [MainSound.eval_sliceAt, Fin.getElem_fin, Vector.getElem_ofFn] at h
      exact h
    · intro k
      show Expression.eval env ((x10[0 * nClaims + k.val]?).getD 0) = 0
      have h := hAnch.2.2.2.2.2.2.2.2 k
      simp only [MainSound.eval_sliceAt, Fin.getElem_fin, Vector.getElem_ofFn] at h
      exact h
    · intro i hA
      rw [hRdef] at hA ⊢
      rw [MainSound.ofVectors_row env _ _ _ _ _ _ _ _ _ _ _ _ _ i
        (by have := i.isLt; simp only [slots]; omega)
        (by have := i.isLt; simp only [slots]; omega)] at hA ⊢
      rw [MainSound.ofVectors_sigF env _ _ _ _ _ _ _ _ _ _ _ _ _ i.val i.isLt]
      exact hMap' i hA
    · show Expression.eval env ((x5[bufferLen * nSt + St.END.val]?).getD 0) = 1
      have h := hAcc.1
      simp only [MainSound.eval_sliceAt, Fin.getElem_fin, Vector.getElem_ofFn] at h
      exact h
    · show Expression.eval env ((x6[bufferLen * nSub + Sub.PLAIN.val]?).getD 0) = 1
      have h := hAcc.2.1
      simp only [MainSound.eval_sliceAt, Fin.getElem_fin, Vector.getElem_ofFn] at h
      exact h
    · show (Expression.eval env ((x12[bufferLen]?).getD 0)).val ≤ _
      rw [MainSound.gd _ _ (by simp [slots])]
      exact hAcc.2.2
  -- the end pins
  have hOut : R.outV =
      { iss := eval env x1.iss, sub := eval env x1.sub, aud := eval env x1.aud,
        azp := eval env x1.azp, hd := eval env x1.hd, email := eval env x1.email,
        emailVerified := eval env x1.emailVerified, nonce := eval env x1.nonce,
        atHash := eval env x1.atHash, iat := eval env x1.iat, exp := eval env x1.exp } := by
    rw [hRdef]; exact eval_outputStruct x1
  have hPS : ∀ (k : Claim) (n : ℕ) (_ : NeZero n) (sv : Var (StrSlot n) (F circomPrime)),
      (StrSlotPin.circuit n).Spec (eval env
          ({ slot := sv,
             present := sumOver x14 (fun s => s.match_[k]),
             len := sumOver x14 (fun s => s.vEmitK[k]) } :
            Var (StrSlotPin.Inputs n) (F circomPrime))) →
      StrSlotPin.Spec n ⟨eval env sv, R.presentSum k, R.lenSum k⟩ := by
    intro k n _ sv h
    rw [show (StrSlotPin.circuit n).Spec = StrSlotPin.Spec n from rfl, eval_strSlotPinIn] at h
    rw [hRdef, MainSound.ofVectors_presentSum .., MainSound.ofVectors_lenSum ..]
    exact h
  have hPI : ∀ (k : Claim) (n : ℕ) (_ : NeZero n) (sv : Var (IntSlot n) (F circomPrime)),
      (IntSlotPin.circuit n).Spec (eval env
          ({ slot := sv,
             present := sumOver x14 (fun s => s.match_[k]),
             negative := sumOver x14 (fun s => s.minusK[k]),
             len := sumOver x14 (fun s => s.vEmitK[k]) } :
            Var (IntSlotPin.Inputs n) (F circomPrime))) →
      IntSlotPin.Spec n ⟨eval env sv, R.presentSum k, R.negSum k, R.lenSum k⟩ := by
    intro k n _ sv h
    rw [show (IntSlotPin.circuit n).Spec = IntSlotPin.Spec n from rfl, eval_intSlotPinIn] at h
    rw [hRdef, MainSound.ofVectors_presentSum .., MainSound.ofVectors_negSum ..,
      MainSound.ofVectors_lenSum ..]
    exact h
  have hPB : ∀ (sv : Var BoolSlot (F circomPrime)),
      BoolSlotPin.circuit.Spec (eval env
          ({ slot := sv,
             present := sumOver x14 (fun s => s.match_[6]),
             value := sumOver x14 (fun s => s.trueK) } :
            Var BoolSlotPin.Inputs (F circomPrime))) →
      BoolSlotPin.Spec ⟨eval env sv, R.presentSum 6, R.trueSum⟩ := by
    intro sv h
    rw [show BoolSlotPin.circuit.Spec = BoolSlotPin.Spec from rfl, eval_boolSlotPinIn] at h
    rw [hRdef, MainSound.ofVectors_presentSum .., MainSound.ofVectors_trueSum ..]
    exact h
  have hA32 : (32 : ℕ) < 2 ^ 64 := by norm_num
  have hA64 : (64 : ℕ) < 2 ^ 64 := by norm_num
  have hA128 : (128 : ℕ) < 2 ^ 64 := by norm_num
  have hA12 : (12 : ℕ) < 2 ^ 64 := by norm_num
  have hiss : StrSlotPin.Spec _ ⟨R.outV.iss, R.presentSum 0, R.lenSum 0⟩ := by
    rw [hOut]; exact hPS 0 _ _ x1.iss (hP0 hA32)
  have hsub : StrSlotPin.Spec _ ⟨R.outV.sub, R.presentSum 1, R.lenSum 1⟩ := by
    rw [hOut]; exact hPS 1 _ _ x1.sub (hP1 hA32)
  have haud : StrSlotPin.Spec _ ⟨R.outV.aud, R.presentSum 2, R.lenSum 2⟩ := by
    rw [hOut]; exact hPS 2 _ _ x1.aud (hP2 hA128)
  have hazp : StrSlotPin.Spec _ ⟨R.outV.azp, R.presentSum 3, R.lenSum 3⟩ := by
    rw [hOut]; exact hPS 3 _ _ x1.azp (hP3 hA128)
  have hhd : StrSlotPin.Spec _ ⟨R.outV.hd, R.presentSum 4, R.lenSum 4⟩ := by
    rw [hOut]; exact hPS 4 _ _ x1.hd (hP4 hA64)
  have hemail : StrSlotPin.Spec _ ⟨R.outV.email, R.presentSum 5, R.lenSum 5⟩ := by
    rw [hOut]; exact hPS 5 _ _ x1.email (hP5 hA128)
  have hev : BoolSlotPin.Spec ⟨R.outV.emailVerified, R.presentSum 6, R.trueSum⟩ := by
    rw [hOut]; exact hPB x1.emailVerified (hP6 trivial)
  have hnonce : StrSlotPin.Spec _ ⟨R.outV.nonce, R.presentSum 7, R.lenSum 7⟩ := by
    rw [hOut]; exact hPS 7 _ _ x1.nonce (hP7 hA64)
  have hatHash : StrSlotPin.Spec _ ⟨R.outV.atHash, R.presentSum 8, R.lenSum 8⟩ := by
    rw [hOut]; exact hPS 8 _ _ x1.atHash (hP8 hA64)
  have hiat : IntSlotPin.Spec _ ⟨R.outV.iat, R.presentSum 9, R.negSum 9, R.lenSum 9⟩ := by
    rw [hOut]; exact hPI 9 _ _ x1.iat (hP9 hA12)
  have hexp : IntSlotPin.Spec _ ⟨R.outV.exp, R.presentSum 10, R.negSum 10, R.lenSum 10⟩ := by
    rw [hOut]; exact hPI 10 _ _ x1.exp (hP10 hA12)
  -- the model, and the bridge
  obtain ⟨hacc, hoNats⟩ := MainSound.spec_of_rows hRows hiss hsub haud hazp hhd hemail hev
    hnonce hatHash hiat hexp
  obtain ⟨j, hparse, htoken, henc⟩ :=
    ModelBridge.sound_bridge (MainSound.bufBytes input.buffer) input.len.val hlen
      (fun i _ => hRows.byteLt i) hacc
  have houtV : R.outV = eval env x1 := by rw [hRdef]; rfl
  rw [← elaborated.output_eq input_var i₀, hout]
  exact MainSound.spec_of_bridge input (eval env x1) env.data hlen j hparse htoken
    (by rw [← houtV]; exact hoNats) henc

end Soundness


/-! ## Completeness

The peel goes the other way: every block is *constructed*, and the witness-IR
sites hand the continuation the fact that the variables they bind evaluate to
the run's projections (`Witgen.lean`'s eleven bridges).  The model content is
`ModelBridge.complete_bridge`: a Google ID token makes the honest run accept. -/

section Completeness

open MainPeel MainSound MainComplete
open Model (St Sub Claim)
open Model (run step runSignals signals)

set_option maxHeartbeats 2000000 in
set_option maxRecDepth 20000 in
theorem completeness :
    GeneralFormalCircuit.Completeness (F circomPrime) main ProverAssumptions ProverSpec := by
  intro i₀ env input_var h_env input h_input h_prover
  refine ⟨?_, trivial⟩
  obtain ⟨⟨hbytes, hlen⟩, htok, hpad⟩ := h_prover
  -- the input, read as plain data
  have h_bufi : ∀ (i : ℕ) (hi : i < bufferLen),
      Expression.eval env.toEnvironment (input_var.buffer[i]'hi) = input.buffer[i]'hi := by
    intro i hi
    rw [← h_input, eval_inputStructP]
    simp only [getElem_eval_vec]
  have h_len : Expression.eval env.toEnvironment input_var.len = input.len := by
    rw [← h_input, eval_inputStructP]
  have hbytesOf : Witness.bytesOf input_var env = MainSound.bufBytes input.buffer := by
    funext j
    by_cases hj : j < bufferLen
    · rw [MainSound.bufBytes_lt _ j hj]
      simp only [Witness.bytesOf, dif_pos hj]
      rw [h_bufi j hj]
    · rw [MainSound.bufBytes_ge _ j hj]
      simp only [Witness.bytesOf, dif_neg hj]
  have hlenOf : Witness.lenOf input_var env = input.len.val := by
    simp only [Witness.lenOf]
    rw [h_len]
  have hbyteLt : ∀ i, MainSound.bufBytes input.buffer i < 256 := by
    intro i
    by_cases hi : i < bufferLen
    · rw [MainSound.bufBytes_lt _ i hi]
      have := hbytes ⟨i, hi⟩
      simpa [fieldElemsToNat] using this
    · rw [MainSound.bufBytes_ge _ i hi]; omega
  have hb256 : ∀ j, (h : j < bufferLen) → (env (input_var.buffer[j]'h)).val < 256 := by
    intro j hj
    have h := hbyteLt j
    rw [MainSound.bufBytes_lt _ j hj] at h
    show (Expression.eval env.toEnvironment (input_var.buffer[j]'hj)).val < 256
    rw [h_bufi j hj]
    exact h
  have hlt : (env input_var.len).val ≤ bufferLen := by
    show (Expression.eval env.toEnvironment input_var.len).val ≤ bufferLen
    rw [h_len]; exact hlen
  -- the honest run accepts
  have hpadB : ∀ i, input.len.val ≤ i → MainSound.bufBytes input.buffer i = 0 := by
    intro i hi
    by_cases hib : i < bufferLen
    · rw [MainSound.bufBytes_lt _ i hib]
      have h := hpad ⟨i, hib⟩ hi
      simp only [Fin.getElem_fin] at h
      rw [h]
      exact ZMod.val_zero
    · rw [MainSound.bufBytes_ge _ i hib]
  obtain ⟨jj, hparse, htoken⟩ := MainComplete.token_of_prover input hlen htok
  have hacc : Model.accepts (MainSound.bufBytes input.buffer) input.len.val = true :=
    ModelBridge.complete_bridge _ _ hlen (fun i _ => hbyteLt i) hpadB jj hparse htoken
  unfold main at h_env ⊢
  refine chc_witnessIR_bind Output env _ _ i₀ h_env ?_
  intro vout n1 hvout h_env
  refine chc_witnessVector_bind env _ _ _ h_env ?_
  intro vlenFlags n2 hvlenFlags h_env
  -- the witnessed length one-hot
  have hlfG : ∀ (i : ℕ) (hi : i < slots),
      Expression.eval env.toEnvironment (vlenFlags[i]'hi)
        = (Witness.lenFlagsGen input.len.val)[i]'hi := by
    intro i hi
    rw [hvlenFlags i hi]
    have h := IR.eval_lenFlagsIR input_var env hlt
    rw [hlenOf, MainComplete.lenFlagsIR_def] at h
    exact congrArg (fun v => v[i]'hi) h
  refine chc_assertion_bind env _ _ _ _ h_env ?_ ?_ ?_
  · trivial
  · rw [show LenFlags.circuit.Spec = LenFlags.Spec from rfl, eval_prover, eval_lenFlagsIn]
    refine ⟨by rw [h_len]; exact hlen, ?_⟩
    intro k
    show (eval env.toEnvironment vlenFlags : Vector (F circomPrime) flagLen)[k.val] = _
    rw [getElem_eval_vec, hlfG k.val k.isLt, h_len]
    rw [Witness.lenFlagsGen, Vector.getElem_ofFn]
    exact MainComplete.ind_eq_ite _ (by simp)
  intro n3 h_env
  refine chc_witnessVector_bind env _ _ _ h_env ?_
  intro vaccm n4 hvaccm h_env
  have haccmG : ∀ (i : ℕ) (hi : i < slots),
      Expression.eval env.toEnvironment (vaccm[i]'hi)
        = (Witness.accmGen input.len.val)[i]'hi := by
    intro i hi
    rw [hvaccm i hi]
    have h := IR.eval_accmIR input_var env hlt
    rw [hlenOf, MainComplete.accmIR_def] at h
    exact congrArg (fun v => v[i]'hi) h
  refine chc_witnessIR_bind (fields (nSt * slots)) env _ _ _ h_env ?_
  intro vst n5 hvst h_env
  refine chc_witnessIR_bind (fields (nSub * slots)) env _ _ _ h_env ?_
  intro vsub n6 hvsub h_env
  refine chc_witnessIR_bind (fields slots) env _ _ _ h_env ?_
  intro vhex n7 hvhex h_env
  refine chc_witnessIR_bind (fields slots) env _ _ _ h_env ?_
  intro vkidx n8 hvkidx h_env
  refine chc_witnessIR_bind (fields (nClaims * slots)) env _ _ _ h_env ?_
  intro vm n9 hvm h_env
  refine chc_witnessIR_bind (fields (nClaims * slots)) env _ _ _ h_env ?_
  intro vclaim n10 hvclaim h_env
  refine chc_witnessIR_bind (fields slots) env _ _ _ h_env ?_
  intro vofs n11 hvofs h_env
  refine chc_witnessIR_bind (fields slots) env _ _ _ h_env ?_
  intro vnmem n12 hvnmem h_env
  -- the witnessed run
  have hstG : ∀ (i : ℕ) (hi : i < nSt * slots),
      Expression.eval env.toEnvironment (vst[i]'hi)
        = (Witness.stGen (MainSound.bufBytes input.buffer) input.len.val)[i]'hi := by
    intro i hi
    have h := IR.eval_stIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    have hv := hvst i hi
    rw [MainComplete.toElements_fields] at hv
    rw [hv]
    exact congrArg (fun v => v[i]'hi) h
  have hsubG : ∀ (i : ℕ) (hi : i < nSub * slots),
      Expression.eval env.toEnvironment (vsub[i]'hi)
        = (Witness.subGen (MainSound.bufBytes input.buffer) input.len.val)[i]'hi := by
    intro i hi
    have h := IR.eval_subIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    have hv := hvsub i hi
    rw [MainComplete.toElements_fields] at hv
    rw [hv]
    exact congrArg (fun v => v[i]'hi) h
  have hhexG : ∀ (i : ℕ) (hi : i < slots),
      Expression.eval env.toEnvironment (vhex[i]'hi)
        = (Witness.hexAccGen (MainSound.bufBytes input.buffer) input.len.val)[i]'hi := by
    intro i hi
    have h := IR.eval_hexAccIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    have hv := hvhex i hi
    rw [MainComplete.toElements_fields] at hv
    rw [hv]
    exact congrArg (fun v => v[i]'hi) h
  have hkidxG : ∀ (i : ℕ) (hi : i < slots),
      Expression.eval env.toEnvironment (vkidx[i]'hi)
        = (Witness.kIdxGen (MainSound.bufBytes input.buffer) input.len.val)[i]'hi := by
    intro i hi
    have h := IR.eval_kIdxIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    have hv := hvkidx i hi
    rw [MainComplete.toElements_fields] at hv
    rw [hv]
    exact congrArg (fun v => v[i]'hi) h
  have hmG : ∀ (i : ℕ) (hi : i < nClaims * slots),
      Expression.eval env.toEnvironment (vm[i]'hi)
        = (Witness.mGen (MainSound.bufBytes input.buffer) input.len.val)[i]'hi := by
    intro i hi
    have h := IR.eval_mIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    have hv := hvm i hi
    rw [MainComplete.toElements_fields] at hv
    rw [hv]
    exact congrArg (fun v => v[i]'hi) h
  have hclaimG : ∀ (i : ℕ) (hi : i < nClaims * slots),
      Expression.eval env.toEnvironment (vclaim[i]'hi)
        = (Witness.claimGen (MainSound.bufBytes input.buffer) input.len.val)[i]'hi := by
    intro i hi
    have h := IR.eval_claimIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    have hv := hvclaim i hi
    rw [MainComplete.toElements_fields] at hv
    rw [hv]
    exact congrArg (fun v => v[i]'hi) h
  have hofsG : ∀ (i : ℕ) (hi : i < slots),
      Expression.eval env.toEnvironment (vofs[i]'hi)
        = (Witness.ofsGen (MainSound.bufBytes input.buffer) input.len.val)[i]'hi := by
    intro i hi
    have h := IR.eval_ofsIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    have hv := hvofs i hi
    rw [MainComplete.toElements_fields] at hv
    rw [hv]
    exact congrArg (fun v => v[i]'hi) h
  have hnmemG : ∀ (i : ℕ) (hi : i < slots),
      Expression.eval env.toEnvironment (vnmem[i]'hi)
        = (Witness.nMemGen (MainSound.bufBytes input.buffer) input.len.val)[i]'hi := by
    intro i hi
    have h := IR.eval_nMemIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    have hv := hvnmem i hi
    rw [MainComplete.toElements_fields] at hv
    rw [hv]
    exact congrArg (fun v => v[i]'hi) h
  have houtG : (eval env.toEnvironment vout : Output (F circomPrime))
      = Witness.outputGen (MainSound.bufBytes input.buffer) input.len.val := by
    refine MainComplete.eval_of_toElements env.toEnvironment vout _ (fun i hi => ?_)
    rw [hvout i hi]
    have h := IR.eval_outIR input_var env hb256 hlt
    rw [hbytesOf, hlenOf] at h
    exact congrArg (fun v => v[i]'hi) h
  -- the witnessed run, read as the model registers
  have hEnc : ∀ (sigs : Vector (Var Step.Outputs (F circomPrime)) bufferLen) (i : ℕ), i < slots →
      MainSound.Enc (MainSound.ofVectors env input_var.buffer vlenFlags vaccm vhex vkidx vofs
        vnmem vst vsub vm vclaim sigs vout) i
        (run (MainSound.bufBytes input.buffer) input.len.val i) := by
    intro sigs i hi
    have hst : ∀ j : Fin nSt, i * nSt + j.val < nSt * slots := by
      intro j; have := j.isLt; simp only [Model.nSt] at *; omega
    have hsub : ∀ j : Fin nSub, i * nSub + j.val < nSub * slots := by
      intro j; have := j.isLt; simp only [Model.nSub] at *; omega
    have hcl : ∀ j : Fin nClaims, i * nClaims + j.val < nClaims * slots := by
      intro j; have := j.isLt; simp only [Model.nClaims] at *; omega
    refine ⟨fun j => ?_, fun j => ?_, ?_, ?_, fun k => ?_, fun k => ?_, ?_, ?_⟩
    · show Expression.eval env.toEnvironment (vst[i * nSt + j.val]?.getD 0) = _
      rw [MainSound.gd _ _ (hst j), hstG _ (hst j), MainComplete.stGen_get]
    · show Expression.eval env.toEnvironment (vsub[i * nSub + j.val]?.getD 0) = _
      rw [MainSound.gd _ _ (hsub j), hsubG _ (hsub j), MainComplete.subGen_get]
    · show Expression.eval env.toEnvironment (vhex[i]?.getD 0) = _
      rw [MainSound.gd _ _ hi, hhexG _ hi, Witness.hexAccGen, Vector.getElem_ofFn]
    · show Expression.eval env.toEnvironment (vkidx[i]?.getD 0) = _
      rw [MainSound.gd _ _ hi, hkidxG _ hi, Witness.kIdxGen, Vector.getElem_ofFn]
    · show Expression.eval env.toEnvironment (vm[i * nClaims + k.val]?.getD 0) = _
      rw [MainSound.gd _ _ (hcl k), hmG _ (hcl k), MainComplete.mGen_get]
    · show Expression.eval env.toEnvironment (vclaim[i * nClaims + k.val]?.getD 0) = _
      rw [MainSound.gd _ _ (hcl k), hclaimG _ (hcl k), MainComplete.claimGen_get]
    · show Expression.eval env.toEnvironment (vofs[i]?.getD 0) = _
      rw [MainSound.gd _ _ hi, hofsG _ hi, Witness.ofsGen, Vector.getElem_ofFn]
    · show Expression.eval env.toEnvironment (vnmem[i]?.getD 0) = _
      rw [MainSound.gd _ _ hi, hnmemG _ hi, Witness.nMemGen, Vector.getElem_ofFn]
  have haccmR : ∀ (sigs : Vector (Var Step.Outputs (F circomPrime)) bufferLen) (i : ℕ), i < slots →
      (MainSound.ofVectors env input_var.buffer vlenFlags vaccm vhex vkidx vofs vnmem vst vsub
        vm vclaim sigs vout).accmF i = if input.len.val < i then 1 else 0 := by
    intro sigs i hi
    show Expression.eval env.toEnvironment (vaccm[i]?.getD 0) = _
    rw [MainSound.gd _ _ hi, haccmG _ hi, Witness.accmGen, Vector.getElem_ofFn]
    exact MainComplete.ind_eq_ite _ (by simp)
  have hlenFlagR : ∀ (sigs : Vector (Var Step.Outputs (F circomPrime)) bufferLen) (i : ℕ),
      i < bufferLen →
      (MainSound.ofVectors env input_var.buffer vlenFlags vaccm vhex vkidx vofs vnmem vst vsub
        vm vclaim sigs vout).lenFlagF i = if i = input.len.val then 1 else 0 := by
    intro sigs i hi
    show Expression.eval env.toEnvironment (vlenFlags[i]?.getD 0) = _
    rw [MainSound.gd _ _ (Nat.lt_succ_of_lt hi), hlfG _ (Nat.lt_succ_of_lt hi), Witness.lenFlagsGen, Vector.getElem_ofFn]
    exact MainComplete.ind_eq_ite _ (by simp)
  have hbyteValR : ∀ (sigs : Vector (Var Step.Outputs (F circomPrime)) bufferLen) (i : ℕ),
      i < bufferLen →
      ((MainSound.ofVectors env input_var.buffer vlenFlags vaccm vhex vkidx vofs vnmem vst vsub
        vm vclaim sigs vout).byteF i).val = MainSound.bufBytes input.buffer i := by
    intro sigs i hi
    show (Expression.eval env.toEnvironment (input_var.buffer[i]?.getD 0)).val = _
    rw [MainSound.gd _ _ hi, h_bufi i hi, MainSound.bufBytes_lt _ i hi]
  have houtR : ∀ (sigs : Vector (Var Step.Outputs (F circomPrime)) bufferLen),
      (MainSound.ofVectors env input_var.buffer vlenFlags vaccm vhex vkidx vofs vnmem vst vsub
        vm vclaim sigs vout).outV
        = Witness.outputGen (MainSound.bufBytes input.buffer) input.len.val :=
    fun _ => houtG
  have hPA : ∀ (sigs : Vector (Var Step.Outputs (F circomPrime)) bufferLen) (i : ℕ), i < bufferLen →
      Step.ProverAssumptions
        ((MainSound.ofVectors env input_var.buffer vlenFlags vaccm vhex vkidx vofs vnmem vst vsub
          vm vclaim sigs vout).row i) env.data env.hint :=
    fun sigs i hi => MainComplete.step_proverAssumptions (hbyteValR sigs) hbyteLt hlen
      (hlenFlagR sigs) (haccmR sigs) (hEnc sigs) (houtR sigs) hacc i hi _
  have hs0 : (0 : ℕ) < slots := by simp only [Witness.slots]; omega
  have hsB : bufferLen < slots := by simp only [Witness.slots]; omega
  obtain ⟨hsteps', hend', hsubP', hmem', hpres'⟩ :=
    (ModelBridge.accepts_iff (MainSound.bufBytes input.buffer) input.len.val).mp hacc
  have hfr : run (MainSound.bufBytes input.buffer) input.len.val bufferLen
      = run (MainSound.bufBytes input.buffer) input.len.val input.len.val :=
    RunTheory.run_frozen _ _ _ hlen
  have hsl : ∀ (i : ℕ) (j : Fin nSt), i < slots → i * nSt + j.val < nSt * slots := by
    intro i j hi; have := j.isLt; simp only [Model.nSt] at *; omega
  have hsl2 : ∀ (i : ℕ) (j : Fin nSub), i < slots → i * nSub + j.val < nSub * slots := by
    intro i j hi; have := j.isLt; simp only [Model.nSub] at *; omega
  have hsl3 : ∀ (i : ℕ) (j : Fin nClaims), i < slots → i * nClaims + j.val < nClaims * slots := by
    intro i j hi; have := j.isLt; simp only [Model.nClaims] at *; omega
  -- the anchors
  refine chc_assertion_bind env _ _ _ _ h_env ?_ ?_ ?_
  · trivial
  · rw [show Anchors.circuit.Spec = Anchors.Spec from rfl, eval_prover, eval_anchorsIn]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [haccmG 0 hs0, Witness.accmGen, Vector.getElem_ofFn]
      simp [Witness.ind]
    · rw [Fin.getElem_fin, MainComplete.slice_get, MainSound.gd _ _ (hsl 0 St.PRE hs0),
        hstG _ (hsl 0 St.PRE hs0), MainComplete.stGen_get]
      exact if_pos rfl
    · rw [Fin.getElem_fin, MainComplete.slice_get, MainSound.gd _ _ (hsl2 0 Sub.PLAIN hs0),
        hsubG _ (hsl2 0 Sub.PLAIN hs0), MainComplete.subGen_get]
      exact if_pos rfl
    · rw [hhexG 0 hs0, Witness.hexAccGen, Vector.getElem_ofFn]
      show ((Model.Regs.init.hexAcc : ℕ) : F circomPrime) = 0
      simp [Model.Regs.init]
    · rw [hkidxG 0 hs0, Witness.kIdxGen, Vector.getElem_ofFn]
      show ((Model.Regs.init.kIdx : ℕ) : F circomPrime) = 0
      simp [Model.Regs.init]
    · rw [hofsG 0 hs0, Witness.ofsGen, Vector.getElem_ofFn]
      show ((Model.Regs.init.ofs : ℕ) : F circomPrime) = 0
      simp [Model.Regs.init]
    · rw [hnmemG 0 hs0, Witness.nMemGen, Vector.getElem_ofFn]
      show ((Model.Regs.init.nMem : ℕ) : F circomPrime) = 0
      simp [Model.Regs.init]
    · intro k
      rw [Fin.getElem_fin, MainComplete.slice_get, MainSound.gd _ _ (hsl3 0 k hs0),
        hmG _ (hsl3 0 k hs0), MainComplete.mGen_get]
      exact if_neg (show ¬ (Model.Regs.init.m[k] = true) by simp [Model.Regs.init])
    · intro k
      rw [Fin.getElem_fin, MainComplete.slice_get, MainSound.gd _ _ (hsl3 0 k hs0),
        hclaimG _ (hsl3 0 k hs0), MainComplete.claimGen_get]
      exact if_neg (show ¬ (Model.Regs.init.claim = some k) by simp [Model.Regs.init])
  intro n13 h_env
  -- every position
  refine chc_map_bind env h_env ?_ ?_
  · intro i j
    refine chc_subA_iff.mpr ?_
    rw [show Step.circuit.ProverAssumptions = Step.ProverAssumptions from rfl]
    simp only [Vector.getElem_finRange, Fin.eta]
    rw [eval_prover, ← MainSound.ofVectors_row env.toEnvironment input_var.buffer vlenFlags vaccm
      vhex vkidx vofs vnmem vst vsub vm vclaim
      (Vector.replicate bufferLen (varFromOffset Step.Outputs 0)) vout i
      (by have := i.isLt; simp only [Witness.slots]; omega)
      (by have := i.isLt; simp only [Witness.slots]; omega)]
    exact hPA _ i.val i.isLt
  intro vsigs n14 hvsigs hMapEnv h_env
  -- the per-position specification the honest prover gets back from the loop
  have hstepSpec : ∀ i : Fin bufferLen,
      Step.Assumptions ((MainSound.ofVectors env.toEnvironment input_var.buffer vlenFlags vaccm vhex vkidx vofs vnmem vst vsub vm vclaim vsigs vout).row i.val) env.data →
        Step.Spec ((MainSound.ofVectors env.toEnvironment input_var.buffer vlenFlags vaccm vhex vkidx vofs vnmem vst vsub vm vclaim vsigs vout).row i.val) ((MainSound.ofVectors env.toEnvironment input_var.buffer vlenFlags vaccm vhex vkidx vofs vnmem vst vsub vm vclaim vsigs vout).sigF i.val) env.data := by
    intro i hA
    have h := MainPeel.ulwc_map_subA hMapEnv i
    simp only [Vector.getElem_finRange, Fin.eta,
      show Step.circuit.ProverAssumptions = Step.ProverAssumptions from rfl,
      show Step.circuit.Assumptions = Step.Assumptions from rfl,
      show Step.circuit.Spec = Step.Spec from rfl, eval_prover] at h
    rw [← MainSound.ofVectors_row env.toEnvironment input_var.buffer vlenFlags vaccm vhex vkidx
      vofs vnmem vst vsub vm vclaim vsigs vout i
      (by have := i.isLt; simp only [Witness.slots]; omega)
      (by have := i.isLt; simp only [Witness.slots]; omega), ← hvsigs] at h
    rw [MainSound.ofVectors_sigF env.toEnvironment input_var.buffer vlenFlags vaccm vhex vkidx
      vofs vnmem vst vsub vm vclaim vsigs vout i.val i.isLt]
    exact h (hPA vsigs i.val i.isLt) hA
  have hRows := MainComplete.rows_of_honest (hbyteValR vsigs) hbyteLt hlen (hlenFlagR vsigs)
    (haccmR vsigs) (hEnc vsigs) hstepSpec hacc
  have hpresentE : ∀ k : Claim,
      Expression.eval env.toEnvironment (sumOver vsigs fun s => s.match_[k])
        = ((Model.presentCount (MainSound.bufBytes input.buffer) input.len.val k : ℕ)
            : F circomPrime) := by
    intro k
    rw [← MainSound.ofVectors_presentSum env.toEnvironment input_var.buffer vlenFlags vaccm vhex
      vkidx vofs vnmem vst vsub vm vclaim vsigs vout k]
    exact MainSound.presentSum_eq hRows hend' k
  have hlenE : ∀ k : Claim,
      Expression.eval env.toEnvironment (sumOver vsigs fun s => s.vEmitK[k])
        = ((Model.slotLen (MainSound.bufBytes input.buffer) input.len.val k : ℕ)
            : F circomPrime) := by
    intro k
    rw [← MainSound.ofVectors_lenSum env.toEnvironment input_var.buffer vlenFlags vaccm vhex
      vkidx vofs vnmem vst vsub vm vclaim vsigs vout k]
    exact MainSound.lenSum_eq hRows hend' k
  have hnegE : ∀ k : Claim,
      Expression.eval env.toEnvironment (sumOver vsigs fun s => s.minusK[k])
        = ((Model.signCount (MainSound.bufBytes input.buffer) input.len.val k : ℕ)
            : F circomPrime) := by
    intro k
    rw [← MainSound.ofVectors_negSum env.toEnvironment input_var.buffer vlenFlags vaccm vhex
      vkidx vofs vnmem vst vsub vm vclaim vsigs vout k]
    exact MainSound.negSum_eq hRows hend' k
  have htrueE : Expression.eval env.toEnvironment (sumOver vsigs fun s => s.trueK)
      = ((Model.trueCount (MainSound.bufBytes input.buffer) input.len.val 6 : ℕ)
          : F circomPrime) := by
    rw [← MainSound.ofVectors_trueSum env.toEnvironment input_var.buffer vlenFlags vaccm vhex
      vkidx vofs vnmem vst vsub vm vclaim vsigs vout]
    exact MainSound.trueSum_eq hRows hend'
  have hslot : (eval env.toEnvironment vout : Output (F circomPrime))
      = Witness.outputGen (MainSound.bufBytes input.buffer) input.len.val := houtG
  rw [eval_outputStruct] at hslot
