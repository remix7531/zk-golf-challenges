theorem isR1CS : Challenge.CostR1CS.isR1CS main :=
  isR1CS_of_IsR1CSCirc
  (fun input hinput => by
    have hbuf : AffineW input.buffer := Cost.affineW_input_buffer input hinput
    have hlen : Affine input.len := Cost.affine_input_len input hinput
    refine Cost.IsR1CSCirc.bindOf Cost.AffineSlots (IsR1CSCirc.witnessIR Output _)
      (fun n => Cost.affineSlots_witnessIR_output _ n) fun out hout => ?_
    obtain ⟨hissP, hissL, hissB, hsubP, hsubL, hsubB, haudP, haudL, haudB,
      hazpP, hazpL, hazpB, hhdP, hhdL, hhdB, hemailP, hemailL, hemailB,
      hevP, hevV, hnonceP, hnonceL, hnonceB, hatHashP, hatHashL, hatHashB,
      hiatP, hiatN, hiatL, hiatD, hexpP, hexpN, hexpL, hexpD⟩ := hout
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessVector slots _)
      (fun n => affineW_witnessVector_output _ _ n) fun lenFlags hlenFlags => ?_
    refine IsR1CSCirc.bind (Cost.r1cs_assertion_lenFlags _ hlen hlenFlags) fun _ => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessVector slots _)
      (fun n => affineW_witnessVector_output _ _ n) fun accm haccm => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessIR (fields (nSt * slots)) _)
      (fun n => Cost.affineW_witnessIR_output _ _ n) fun st hst => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessIR (fields (nSub * slots)) _)
      (fun n => Cost.affineW_witnessIR_output _ _ n) fun sub hsub => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessIR (fields slots) _)
      (fun n => Cost.affineW_witnessIR_output _ _ n) fun hexAcc hhexAcc => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessIR (fields slots) _)
      (fun n => Cost.affineW_witnessIR_output _ _ n) fun kIdx hkIdx => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessIR (fields (nClaims * slots)) _)
      (fun n => Cost.affineW_witnessIR_output _ _ n) fun m hm => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessIR (fields (nClaims * slots)) _)
      (fun n => Cost.affineW_witnessIR_output _ _ n) fun claim hclaim => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessIR (fields slots) _)
      (fun n => Cost.affineW_witnessIR_output _ _ n) fun ofs hofs => ?_
    refine Cost.IsR1CSCirc.bindW (IsR1CSCirc.witnessIR (fields slots) _)
      (fun n => Cost.affineW_witnessIR_output _ _ n) fun nMem hnMem => ?_
    refine IsR1CSCirc.bind (Cost.r1cs_assertion_anchors _
      (haccm 0 (by simp [slots]))
      (Cost.affineW_sliceAt hst 0 (by simp [slots]))
      (Cost.affineW_sliceAt hsub 0 (by simp [slots]))
      (hhexAcc 0 (by simp [slots])) (hkIdx 0 (by simp [slots]))
      (hofs 0 (by simp [slots])) (hnMem 0 (by simp [slots]))
      (Cost.affineW_sliceAt hm 0 (by simp [slots]))
      (Cost.affineW_sliceAt hclaim 0 (by simp [slots]))) fun _ => ?_
    refine Cost.IsR1CSCirc.bindOf Cost.AffineSigs (Cost.IsR1CSCirc.mapVec_mem fun i k => ?_)
      (fun n => Cost.affineSigs_map_output _ _
        (fun _ n => Cost.affineSig_sub_step_output _ n) n) fun sigs hsigs => ?_
    · simp only [Vector.getElem_finRange]
      have hlt : i.val < slots := by have := i.isLt; simp only [slots]; omega
      have hlt' : i.val + 1 < slots := by have := i.isLt; simp only [slots]; omega
      refine Cost.r1cs_sub_step _ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
        ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ k
      · exact hbuf i.val i.isLt
      · exact Cost.affine_prevAt hlenFlags i
      · exact Cost.affine_prevAt haccm i
      · exact Cost.affine_nextAt haccm i
      · exact Cost.affineW_sliceAt hst i.val hlt
      · exact Cost.affineW_sliceAt hst (i.val + 1) hlt'
      · exact Cost.affineW_sliceAt hsub i.val hlt
      · exact Cost.affineW_sliceAt hsub (i.val + 1) hlt'
      · exact Cost.affine_prevAt hhexAcc i
      · exact Cost.affine_nextAt hhexAcc i
      · exact Cost.affine_prevAt hkIdx i
      · exact Cost.affine_nextAt hkIdx i
      · exact Cost.affineW_sliceAt hm i.val hlt
      · exact Cost.affineW_sliceAt hm (i.val + 1) hlt'
      · exact Cost.affineW_sliceAt hclaim i.val hlt
      · exact Cost.affineW_sliceAt hclaim (i.val + 1) hlt'
      · exact Cost.affine_prevAt hofs i
      · exact Cost.affine_nextAt hofs i
      · exact Cost.affine_prevAt hnMem i
      · exact Cost.affine_nextAt hnMem i
      · exact hissB
      · exact hsubB
      · exact haudB
      · exact hazpB
      · exact hhdB
      · exact hemailB
      · exact hnonceB
      · exact hatHashB
      · exact hiatD
      · exact hexpD
    refine IsR1CSCirc.bind (Cost.r1cs_assertion_acceptance _
      (Cost.affineW_sliceAt hst bufferLen (by simp [slots]))
      (Cost.affineW_sliceAt hsub bufferLen (by simp [slots]))
      (hnMem bufferLen (by simp [slots]))) fun _ => ?_
    have hmatch : ∀ k : Model.Claim, Affine (sumOver sigs fun s => s.match_[k]) :=
      fun k => Cost.affine_sumOver fun i => (hsigs i.val i.isLt).match_ _ _
    have hvEmit : ∀ k : Model.Claim, Affine (sumOver sigs fun s => s.vEmitK[k]) :=
      fun k => Cost.affine_sumOver fun i => (hsigs i.val i.isLt).vEmitK _ _
    have hminus : ∀ k : Model.Claim, Affine (sumOver sigs fun s => s.minusK[k]) :=
      fun k => Cost.affine_sumOver fun i => (hsigs i.val i.isLt).minusK _ _
    have htrue : Affine (sumOver sigs fun s => s.trueK) :=
      Cost.affine_sumOver fun i => (hsigs i.val i.isLt).trueK
    exact
      IsR1CSCirc.bind (Cost.r1cs_assertion_strSlotPin 32 _ (hmatch 0) (hvEmit 0)
        hissP hissL hissB) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_strSlotPin 32 _ (hmatch 1) (hvEmit 1)
        hsubP hsubL hsubB) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_strSlotPin 128 _ (hmatch 2) (hvEmit 2)
        haudP haudL haudB) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_strSlotPin 128 _ (hmatch 3) (hvEmit 3)
        hazpP hazpL hazpB) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_strSlotPin 64 _ (hmatch 4) (hvEmit 4)
        hhdP hhdL hhdB) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_strSlotPin 128 _ (hmatch 5) (hvEmit 5)
        hemailP hemailL hemailB) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_boolSlotPin _ (hmatch 6) htrue
        hevP hevV) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_strSlotPin 64 _ (hmatch 7) (hvEmit 7)
        hnonceP hnonceL hnonceB) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_strSlotPin 64 _ (hmatch 8) (hvEmit 8)
        hatHashP hatHashL hatHashB) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_intSlotPin 12 _ (hmatch 9) (hminus 9) (hvEmit 9)
        hiatP hiatN hiatL hiatD) fun _ =>
      IsR1CSCirc.bind (Cost.r1cs_assertion_intSlotPin 12 _ (hmatch 10) (hminus 10) (hvEmit 10)
        hexpP hexpN hexpL hexpD) fun _ =>
      IsR1CSCirc.pure _)
  (fun input _ n => by
    show AffineProvable ((main input).output n)
    simp only [main, Circuit.bind_output_eq, Circuit.pure_output_eq]
    exact Cost.affineProvable_witnessIR_output _ _)

