/-!
# Baseline `JSONExtract` solution: Google ID token claims extraction

`main` witnesses the automaton run of
`Model.lean` (states and registers, one slot per position plus a final one)
and composes the gadgets: `Anchors` (the initial state), `LenFlags` (the
length one-hot), `Step` at every position, `Acceptance` (final state, member
cap), and one slot pin per claim (`StrSlotPin`/`IntSlotPin`/`BoolSlotPin`:
presence, length, sign, value, and the zeroing of padding cells).

All seven obligations are proved: `mainCost`, `isR1CS` and `witgenIsIR` from
the compositional certificates of `Cost.lean`; `computableWitness` from the
per-gadget lemmas and the witness-IR agreement toolkit of
`ComputableWitness.lean`; `requirementsChannelsLawful` by the field's default
tactic (`Step`'s own instance comes from `ChannelsLawful.lean`);
`soundness` and `completeness` from the loop invariant of `MainSoundness.lean` /
the honest reading of `MainCompleteness.lean` and the two model-level bridges of
`ModelBridge.lean` (`sound_bridge`, `complete_bridge`).
-/

namespace Solution.JSONExtract

open Challenge.Instances.JSONExtract.Interface
open Challenge.CostR1CS
open Challenge.WitgenIR
open Model (nSt nSub nClaims)
open Witness (slots bytesOf lenOf)

set_option maxHeartbeats 8000000 in
def main (input : Var Input (F circomPrime)) :
    Circuit (F circomPrime) (Var Output (F circomPrime)) := do
  -- the honest run of `Model.lean`, generated by the unrolled witness-IR program of
  -- `Witgen.lean` (`IR.runSteps`), which is what `witgenIsIR` needs
  let out ← witnessIR Output (IR.outIR input)
  -- the length one-hot (over the positions and the end position `bufferLen`, so a
  -- document filling the whole buffer has a flag) and its prefix sum
  let lenFlags ← witnessVector slots (IR.lenFlagsOut input)
  LenFlags.circuit { len := input.len, lenFlags := lenFlags }
  let accm ← witnessVector slots (IR.accmOut input)
  -- the run: states and registers, one slot per position plus the final one
  let st ← witnessIR (fields (nSt * slots)) (IR.stIR input)
  let sub ← witnessIR (fields (nSub * slots)) (IR.subIR input)
  let hexAcc ← witnessIR (fields slots) (IR.hexAccIR input)
  let kIdx ← witnessIR (fields slots) (IR.kIdxIR input)
  let m ← witnessIR (fields (nClaims * slots)) (IR.mIR input)
  let claim ← witnessIR (fields (nClaims * slots)) (IR.claimIR input)
  let ofs ← witnessIR (fields slots) (IR.ofsIR input)
  let nMem ← witnessIR (fields slots) (IR.nMemIR input)
  Anchors.circuit {
    accm := accm[0]'(by simp [slots]), st := sliceAt nSt st 0 (by simp [slots]),
    sub := sliceAt nSub sub 0 (by simp [slots]), hexAcc := hexAcc[0]'(by simp [slots]),
    kIdx := kIdx[0]'(by simp [slots]), ofs := ofs[0]'(by simp [slots]), nMem := nMem[0]'(by simp [slots]),
    m := sliceAt nClaims m 0 (by simp [slots]), claim := sliceAt nClaims claim 0 (by simp [slots]) }
  -- every position
  let sigs ← Circuit.map (Vector.finRange bufferLen) fun i =>
    Step.circuit {
      byte := input.buffer[i], lenFlag := prevAt lenFlags i,
      accmPrev := prevAt accm i, accmNext := nextAt accm i,
      stPrev := sliceAt nSt st i.val (by have := i.isLt; simp only [slots]; omega),
      stNext := sliceAt nSt st (i.val + 1) (by have := i.isLt; simp only [slots]; omega),
      subPrev := sliceAt nSub sub i.val (by have := i.isLt; simp only [slots]; omega),
      subNext := sliceAt nSub sub (i.val + 1) (by have := i.isLt; simp only [slots]; omega),
      hexAccPrev := prevAt hexAcc i, hexAccNext := nextAt hexAcc i,
      kIdxPrev := prevAt kIdx i, kIdxNext := nextAt kIdx i,
      mPrev := sliceAt nClaims m i.val (by have := i.isLt; simp only [slots]; omega),
      mNext := sliceAt nClaims m (i.val + 1) (by have := i.isLt; simp only [slots]; omega),
      claimPrev := sliceAt nClaims claim i.val (by have := i.isLt; simp only [slots]; omega),
      claimNext := sliceAt nClaims claim (i.val + 1) (by have := i.isLt; simp only [slots]; omega),
      ofsPrev := prevAt ofs i, ofsNext := nextAt ofs i,
      nMemPrev := prevAt nMem i, nMemNext := nextAt nMem i,
      out := out }
  Acceptance.circuit {
    st := sliceAt nSt st bufferLen (by simp [slots]), sub := sliceAt nSub sub bufferLen (by simp [slots]),
    nMem := nMem[bufferLen]'(by simp [slots]) }
  -- the slots, from the per-position signals
  let present := fun k : Model.Claim => sumOver sigs fun s => s.match_[k]
  let len := fun k : Model.Claim => sumOver sigs fun s => s.vEmitK[k]
  let neg := fun k : Model.Claim => sumOver sigs fun s => s.minusK[k]
  let trueSum := sumOver sigs fun s => s.trueK
  StrSlotPin.circuit 32 { slot := out.iss, present := present 0, len := len 0 }
  StrSlotPin.circuit 32 { slot := out.sub, present := present 1, len := len 1 }
  StrSlotPin.circuit 128 { slot := out.aud, present := present 2, len := len 2 }
  StrSlotPin.circuit 128 { slot := out.azp, present := present 3, len := len 3 }
  StrSlotPin.circuit 64 { slot := out.hd, present := present 4, len := len 4 }
  StrSlotPin.circuit 128 { slot := out.email, present := present 5, len := len 5 }
  BoolSlotPin.circuit { slot := out.emailVerified, present := present 6, value := trueSum }
  StrSlotPin.circuit 64 { slot := out.nonce, present := present 7, len := len 7 }
  StrSlotPin.circuit 64 { slot := out.atHash, present := present 8, len := len 8 }
  IntSlotPin.circuit 12 { slot := out.iat, present := present 9, negative := neg 9, len := len 9 }
  IntSlotPin.circuit 12 { slot := out.exp, present := present 10, negative := neg 10, len := len 10 }
  return out

set_option maxHeartbeats 8000000 in
set_option maxRecDepth 100000 in
instance elaborated : ElaboratedCircuit (F circomPrime) Input Output main := by
  elaborate_circuit

/-- Structural size of the elaborated circuit, certified by `mainCost` below from the
compositional `CostIs` certificates of `Cost.lean`. -/
@[reducible] def allocations : Nat := 1370541
@[reducible] def constraints : Nat := 1446970

/-! ## Soundness

`main` is a 26-block `do` spine whose fourteenth block is a 1024-iteration
`Circuit.map`, so the peel is block by block (`MainPeel.lean`), the gadget
interfaces are evaluated through their input literals (`MainEval.lean`), and the
whole mathematical content is the loop invariant of `MainSoundness.lean` plus
the model-level bridge of `ModelBridge.lean`. -/

section Soundness

open MainPeel MainSound
open Model (St Sub Claim)

