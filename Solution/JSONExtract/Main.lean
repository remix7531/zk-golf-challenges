theorem stable_sumOver {P : TypeMap} [CircuitType P] {n0 : ℕ} {pin : Var P (F circomPrime)}
    {sigs : Vector (Var Step.Outputs (F circomPrime)) bufferLen}
    {f : Var Step.Outputs (F circomPrime) → Expression (F circomPrime)}
    (h : ∀ i : Fin bufferLen, Stable n0 pin (f sigs[i])) : Stable n0 pin (sumOver sigs f) := by
  unfold sumOver
  exact Stable.finFoldl _ _ _ (Stable.const 0) fun acc i hacc => Stable.add hacc (h i)

syntax "pin_input_tac" : tactic
macro_rules
  | `(tactic| pin_input_tac) => `(tactic|
      (intro envA envB hagree hp
       simp only [circuit_norm, sliceAt, prevAt, nextAt, Vector.getElem_ofFn]
       and_intros <;>
         first
           | (refine CW.Stable.apply ?_ envA envB hagree hp
              refine stable_sumOver fun i => ?_
              simp only [Vector.getElem_mapIdx, Vector.getElem_finRange, circuit_norm,
                Step.circuit, Model.nSt, Model.nSub, Model.nClaims, Model.kIdxMax,
                Model.ofsMax]
              exact CW.Stable.var (by omega))
           | exact hagree _ (by omega)
           | (apply Vector.ext
              intro j hj
              simp only [Vector.getElem_map, Vector.getElem_mapRange, Expression.eval]
              exact hagree _ (by omega))))

syntax "main_input_tac" : tactic
macro_rules
  | `(tactic| main_input_tac) => `(tactic|
      (intro envA envB hagree hp
       have hp' := hp
       try simp only [CircuitType.eval_expression_prover_to_verifier,
         ProvableStruct.eval_eq_eval] at hp
       simp only [circuit_norm, sliceAt, prevAt, nextAt, Vector.getElem_ofFn]
       and_intros <;>
         first
           | exact hagree _ (by omega)
           | rw [hp]
           | (refine CW.Stable.apply ?_ envA envB hagree hp'
              stable_tac)
           | (apply Vector.ext
              intro j hj
              simp only [Vector.getElem_map, Vector.getElem_ofFn, Vector.getElem_mapRange,
                Expression.eval]
              exact hagree _ (by omega))))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
theorem computableWitness : ∀ n input,
    ProverEnvironment.OnlyAccessedBelow n
      (fun env : ProverEnvironment (F circomPrime) => eval env input) →
    Circuit.ComputableWitnesses (main input) n := by
  intro n input hinput
  refine CW.computableWitnesses_of_structural input (main input) n hinput ?_
  intro env env'
  have hslots : Witness.slots = 1025 := rfl
  have hbl : bufferLen = 1024 := rfl
  have h1 : Specs.JSONExtract.issMax = 32 := rfl
  have h2 : Specs.JSONExtract.subMax = 32 := rfl
  have h3 : Specs.JSONExtract.audMax = 128 := rfl
  have h4 : Specs.JSONExtract.hdMax = 64 := rfl
  have h5 : Specs.JSONExtract.emailMax = 128 := rfl
  have h6 : Specs.JSONExtract.nonceMax = 64 := rfl
  have h7 : Specs.JSONExtract.atHashMax = 64 := rfl
  have h8 : Specs.JSONExtract.timeMax = 12 := rfl
  have hlenS : ∀ m, Stable m input input.len := fun m =>
    Stable.of_eval (fun v => v.len) fun envX => by simp [circuit_norm]
  have hbufS : ∀ (m j : ℕ) (hj : j < bufferLen), Stable m input (input.buffer[j]'hj) := by
    intro m j hj
    refine Stable.of_eval (fun v => v.buffer[j]'hj) fun envX => ?_
    simp [circuit_norm]
  unfold main
  cw_peel [and_true, witnessIR_localLength, witnessVector_localLength, size_fields', size_Output', witnessIR_output, witnessVector_output, step_localLength, lenFlags_localLength, anchors_localLength,
    acceptance_localLength, strSlotPin_localLength, intSlotPin_localLength,
    boolSlotPin_localLength,
    CW.sub_localLength, CW.subWithAssertion_localLength, CW.assertion_localLength]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro hagree hp
    exact IRAgree.outIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.lenFlagsOut_eval_agree input (hlenS _ _ _ hagree hp)
  · exact CW.flat_assertion LenFlags.circuit input _ _ _ (by with_reducible rfl)
      (by stableP_tac) LenFlags.computableWitnesses env env'
  · intro hagree hp
    exact IRAgree.accmOut_eval_agree input (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.stIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.subIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.hexAccIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.kIdxIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.mIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.claimIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.ofsIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · intro hagree hp
    exact IRAgree.nMemIR_agree input (fun j hj => hbufS _ j hj _ _ hagree hp) (hlenS _ _ _ hagree hp)
  · refine CW.flat_assertion Anchors.circuit input _ _ _ ?_ ?_ Anchors.computableWitnesses env env'
    · with_reducible rfl
    · main_input_tac
  · intro i
    exact CW.flat_general Step.circuit input _ _ _ (by with_reducible rfl)
      (by main_input_tac) Step.computableWitnesses env env'
  · exact CW.flat_assertion Acceptance.circuit input _ _ _ (by with_reducible rfl)
      (by main_input_tac) Acceptance.computableWitnesses env env'
  · exact CW.flat_assertion (StrSlotPin.circuit 32) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (StrSlotPin.computableWitnesses 32) env env'
  · exact CW.flat_assertion (StrSlotPin.circuit 32) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (StrSlotPin.computableWitnesses 32) env env'
  · exact CW.flat_assertion (StrSlotPin.circuit 128) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (StrSlotPin.computableWitnesses 128) env env'
  · exact CW.flat_assertion (StrSlotPin.circuit 128) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (StrSlotPin.computableWitnesses 128) env env'
  · exact CW.flat_assertion (StrSlotPin.circuit 64) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (StrSlotPin.computableWitnesses 64) env env'
  · exact CW.flat_assertion (StrSlotPin.circuit 128) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (StrSlotPin.computableWitnesses 128) env env'
  · exact CW.flat_assertion (BoolSlotPin.circuit) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (BoolSlotPin.computableWitnesses) env env'
  · exact CW.flat_assertion (StrSlotPin.circuit 64) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (StrSlotPin.computableWitnesses 64) env env'
  · exact CW.flat_assertion (StrSlotPin.circuit 64) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (StrSlotPin.computableWitnesses 64) env env'
  · exact CW.flat_assertion (IntSlotPin.circuit 12) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (IntSlotPin.computableWitnesses 12) env env'
  · exact CW.flat_assertion (IntSlotPin.circuit 12) input _ _ _ (by with_reducible rfl)
      (by pin_input_tac) (IntSlotPin.computableWitnesses 12) env env'

end ComputableWitnessPeel

